# Kopieer naar .env en vul in.

# Wie er oefenen (gescheiden opnames, geschiedenis en voortgang).
GEBRUIKERS=Gebruiker 1,Gebruiker 2

# Waarop de trainer bereikbaar is in het thuisnetwerk: naam en/of vast IP-adres van de server, met de poort.
# Het certificaat geldt alleen voor deze adressen.
SITE_ADRESSEN=https://server.local:8443, https://192.168.1.10:8443
HTTPS_POORT=8443

# Kernen voor de analyse (de server heeft er 4; één blijft vrij voor de rest).
ANALYSE_KERNEN=3

# Alleen voor het bijwerken van de teksten (import): waar de A- en B-site staan, gezien vanuit de map app/.
BRON_A=../../svenska_ovningar
BRON_B=../../svenska_ovningar_b
